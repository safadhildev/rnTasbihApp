{
  "name": "myTasbih",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev:debug": "react-native run-android --mode=devDebug --appId=com.myTasbih.dev",
    "android:dev:release": "react-native run-android --mode=devRelease --appId=com.myTasbih.dev",
    "android:production:debug": "ENV_FILE=production react-native run-android --mode=productionDebug --appId=com.myTasbih",
    "android:production:release": "ENV_FILE=production react-native run-android --mode=productionRelease --appId=com.myTasbih",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:8083": "react-native start --port 8083",
    "start:8083:prod": "ENV_FILE=production react-native start --port 8083 --reset-cache",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "iconoir-react-native": "^7.12.1",
    "moment": "^2.30.1",
    "moment-hijri": "^2.30.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "16.5.0",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.29.0",
    "react-native-svg": "^15.15.5",
    "react-native-uuid": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
